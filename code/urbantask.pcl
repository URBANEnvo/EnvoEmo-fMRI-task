# SAM

int x = 1;
int response_counter;
int sam_time;
#int R = 0;
int P = 1;
response_data last_response;
output_file outfile = new output_file;
#string printtext = "Print.";
outfile.open(logfile.subject () + "_sam_readout.txt");

# SAM arousal#
sub
	vas_arousal
begin
	#SAM_instruct_trial.present();
	loop
		int ivas = 1;
	until
		ivas == 2
	begin
		int j = 0;
		int k = 0;
		int l = 0;
		
		loop 
			int i = 0;
		until
			i == 1
		begin
			vaspic.set_part_x(2, j);
			vaspic.set_part(3,samarousal);
         vas_present.present();
			#last_response = response_manager.last_response_data ();
	      if response_manager.response_count() > 0 then 
            outfile.print("SAM_arousal" + "," + string( j ) + "\n");
         if (response_manager.last_response() == 3 && j < 500) then 
				j = j + 100
			elseif (response_manager.last_response() == 2 && j > -500) then
				j = j - 100
			elseif (response_manager.last_response() == 1) then
				i = 1 
			else 
				i = 0;
			end;
                #outfile.print(printtext + "\t" + string(response_manager.last_response ()) + "\n");
		   else 
            outfile.print ("\tno response\n");
            j=-999;
            i = 1;
	      end;
		end;
		
		event1.set_event_code ("SAM_arousal" + "," + string( j ));
		save.present();
		ivas = ivas + 1;
	end;
end;

################# SUB valence #################
sub
	vas_valenz
begin
	cross_trial.present ();
	loop
		int ivas = 1;
	until
		ivas == 2
	begin
		int j = 0;
		int k = 0;
		int l = 0;
		
		loop 
			int i = 0;
		until
			i == 1
		begin
			vaspic.set_part_x(2, j);
			vaspic.set_part(3,samvalenz);
         vas_present.present();
	      if response_manager.response_count() > 0 then 
            outfile.print("\t" + "SAM_valenz" + "," + string( j )+ "\n");
         if (response_manager.last_response() == 3 && j < 500) then 
				j = j + 100
			elseif (response_manager.last_response() == 2 && j > -500) then
				j = j - 100
			elseif (response_manager.last_response() == 1) then
				i = 1 
			else 
				i = 0;
			end;
		   else 
            outfile.print ("\tno response\n");
            j=-999;
            i = 1;
	      end;
			
		end;
		
		event1.set_event_code ("SAM_valenz" + "," + string( j ));
		save.present();
		ivas = ivas + 1;
	end;
end;


